#include <stdio.h>
#include <stdlib.h>
#include <string.h>

struct SinhVien {
    int maSV;
    char tenSV[50];
    char lop[20];
    float tongKet;
    char hanhKiem[20];
};

struct Node {
    struct SinhVien data;
    struct Node *left;
    struct Node *right;
};

typedef struct Node* Tree;

// 1. Khoi tao cay
void khoiTao(Tree *t) {
    *t = NULL;
}

// 2. Tao nut moi
Tree taoNode(struct SinhVien x) {
    Tree p = (Tree)malloc(sizeof(struct Node));

    if(p == NULL)
        return NULL;

    p->data = x;
    p->left = NULL;
    p->right = NULL;

    return p;
}

// 3. Chen vao cay
void chenNode(Tree *t, struct SinhVien x) {
    if(*t == NULL) {
        *t = taoNode(x);
        return;
    }

    if(x.maSV < (*t)->data.maSV)
        chenNode(&(*t)->left, x);
    else if(x.maSV > (*t)->data.maSV)
        chenNode(&(*t)->right, x);
}

// 4. Tim kiem
Tree timKiem(Tree t, int ma) {
    if(t == NULL)
        return NULL;

    if(ma == t->data.maSV)
        return t;

    if(ma < t->data.maSV)
        return timKiem(t->left, ma);

    return timKiem(t->right, ma);
}

// 5. Duyet cay (LNR)
void duyetCay(Tree t) {
    if(t != NULL) {
        duyetCay(t->left);

        printf("\nMa SV: %d", t->data.maSV);
        printf("\nTen SV: %s", t->data.tenSV);
        printf("\nLop: %s", t->data.lop);
        printf("\nTong ket: %.2f", t->data.tongKet);
        printf("\nHanh kiem: %s\n", t->data.hanhKiem);

        duyetCay(t->right);
    }
}

int main() {
    Tree t;
    khoiTao(&t);

    int n, i;

    printf("Nhap so sinh vien: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++) {
        struct SinhVien sv;

        printf("\nNhap sinh vien thu %d\n", i + 1);

        printf("Ma SV: ");
        scanf("%d", &sv.maSV);
        getchar();

        printf("Ten SV: ");
        gets(sv.tenSV);

        printf("Lop: ");
        gets(sv.lop);

        printf("Tong ket: ");
        scanf("%f", &sv.tongKet);
        getchar();

        printf("Hanh kiem: ");
        gets(sv.hanhKiem);

        chenNode(&t, sv);
    }

    printf("\n\nDANH SACH SINH VIEN TRONG CAY:\n");
    duyetCay(t);

    int maCanTim;
    printf("\nNhap ma sinh vien can tim: ");
    scanf("%d", &maCanTim);

    Tree kq = timKiem(t, maCanTim);

    if(kq != NULL) {
        printf("\nTim thay sinh vien:\n");
        printf("Ma SV: %d\n", kq->data.maSV);
        printf("Ten SV: %s\n", kq->data.tenSV);
        printf("Lop: %s\n", kq->data.lop);
        printf("Tong ket: %.2f\n", kq->data.tongKet);
        printf("Hanh kiem: %s\n", kq->data.hanhKiem);
    }
    else {
        printf("\nKhong tim thay sinh vien co ma %d", maCanTim);
    }

    return 0;
}
