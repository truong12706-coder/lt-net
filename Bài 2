using System;

public class Person
{
    public string Id { get; init; }
    public string FullName { get; set; }
    public int BirthYear { get; set; }

    public Person(
        string id,
        string fullName,
        int birthYear)
    {
        Id = id;
        FullName = fullName;
        BirthYear = birthYear;
    }

    public int GetAge(int currentYear)
    {
        return currentYear - BirthYear;
    }
}

public class Employee : Person
{
    public decimal BaseSalary { get; set; }

    public Employee(
        string id,
        string fullName,
        int birthYear,
        decimal baseSalary)
        : base(id, fullName, birthYear)
    {
        BaseSalary = baseSalary;
    }

    public virtual decimal CalculateIncome()
    {
        return BaseSalary;
    }
}

public sealed class Manager : Employee
{
    public decimal ResponsibilityAllowance { get; set; }

    public Manager(
        string id,
        string fullName,
        int birthYear,
        decimal baseSalary,
        decimal allowance)
        : base(id, fullName, birthYear, baseSalary)
    {
        ResponsibilityAllowance = allowance;
    }

    public override decimal CalculateIncome()
    {
        return BaseSalary + ResponsibilityAllowance;
    }
}

class Program
{
    static void Main()
    {
        Console.OutputEncoding = System.Text.Encoding.UTF8;

        int currentYear = 2026;

        Console.WriteLine(
            "===== BÀI 2: HỆ THỐNG NHÂN VIÊN =====");
        Console.WriteLine();

        // Tạo Employee
        Employee employee = new Employee(
            "NV001",
            "Nguyễn Văn An",
            2003,
            10000000);

        // Tạo Manager
        Manager manager = new Manager(
            "QL001",
            "Trần Văn Bình",
            1995,
            15000000,
            5000000);

        // =========================
        // PHIẾU LƯƠNG EMPLOYEE
        // =========================

        Console.WriteLine("===== PHIẾU LƯƠNG NHÂN VIÊN =====");

        Console.WriteLine("Mã nhân viên: " + employee.Id);

        Console.WriteLine(
            "Họ tên: " + employee.FullName);

        Console.WriteLine(
            "Tuổi: " + employee.GetAge(currentYear));

        Console.WriteLine(
            "Lương cơ bản: " +
            employee.BaseSalary.ToString("N0") +
            " VNĐ");

        Console.WriteLine(
            "Thu nhập thực lĩnh: " +
            employee.CalculateIncome().ToString("N0") +
            " VNĐ");

        Console.WriteLine();

        // =========================
        // PHIẾU LƯƠNG MANAGER
        // =========================

        Console.WriteLine("===== PHIẾU LƯƠNG QUẢN LÝ =====");

        Console.WriteLine("Mã nhân viên: " + manager.Id);

        Console.WriteLine(
            "Họ tên: " + manager.FullName);

        Console.WriteLine(
            "Tuổi: " + manager.GetAge(currentYear));

        Console.WriteLine(
            "Lương cơ bản: " +
            manager.BaseSalary.ToString("N0") +
            " VNĐ");

        Console.WriteLine(
            "Phụ cấp trách nhiệm: " +
            manager.ResponsibilityAllowance.ToString("N0") +
            " VNĐ");

        Console.WriteLine(
            "Thu nhập thực lĩnh: " +
            manager.CalculateIncome().ToString("N0") +
            " VNĐ");

        Console.WriteLine();

        // Manager được khai báo sealed nên không thể kế thừa tiếp.
        //
        // Ví dụ sau sẽ báo lỗi:
        //
        // class Director : Manager
        // {
        // }
        //
        // Vì Manager là sealed.

        Console.WriteLine(
            "Manager được khai báo sealed nên không thể kế thừa tiếp.");

        Console.WriteLine();
        Console.WriteLine("Kết thúc Bài 2.");
    }
}
