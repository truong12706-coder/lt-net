#include <stdio.h>
#include <string.h>

struct NhanVien {
    int maNV;
    char hoTen[50];
    char ngaySinh[11];
    float luong;
};

void nhap(struct NhanVien ds[], int n) {
    int i;
    for(i = 0; i < n; i++) {
        printf("\nNhap nhan vien thu %d:\n", i + 1);

        printf("Ma nhan vien: ");
        scanf("%d", &ds[i].maNV);
        getchar();

        printf("Ho ten: ");
        gets(ds[i].hoTen);

        printf("Ngay sinh (dd/mm/yyyy): ");
        gets(ds[i].ngaySinh);

        printf("Luong (trieu dong): ");
        scanf("%f", &ds[i].luong);
        getchar();
    }
}

void xuat(struct NhanVien ds[], int n) {
    int i;
    printf("\nDANH SACH NHAN VIEN\n");
    for(i = 0; i < n; i++) {
        printf("\nMa NV: %d", ds[i].maNV);
        printf("\nHo ten: %s", ds[i].hoTen);
        printf("\nNgay sinh: %s", ds[i].ngaySinh);
        printf("\nLuong: %.2f trieu\n", ds[i].luong);
    }
}

void bubbleSort(struct NhanVien ds[], int n) {
    int i, j;
    struct NhanVien temp;

    for(i = 0; i < n - 1; i++) {
        for(j = 0; j < n - i - 1; j++) {
            if(ds[j].luong > ds[j + 1].luong) {
                temp = ds[j];
                ds[j] = ds[j + 1];
                ds[j + 1] = temp;
            }
        }
    }
}

int binarySearch(struct NhanVien ds[], int n, float x) {
    int left = 0;
    int right = n - 1;

    while(left <= right) {
        int mid = (left + right) / 2;

        if(ds[mid].luong == x)
            return mid;
        else if(ds[mid].luong < x)
            left = mid + 1;
        else
            right = mid - 1;
    }

    return -1;
}

int main() {
    int n;
    float X;

    struct NhanVien ds[100];

    printf("Nhap so nhan vien: ");
    scanf("%d", &n);

    nhap(ds, n);

    printf("\nDanh sach vua nhap:\n");
    xuat(ds, n);

    bubbleSort(ds, n);

    printf("\nDanh sach sau khi sap xep tang dan theo luong:\n");
    xuat(ds, n);

    printf("\nNhap muc luong can tim: ");
    scanf("%f", &X);

    int vt = binarySearch(ds, n, X);

    if(vt != -1) {
        printf("\nTim thay nhan vien:\n");
        printf("Ma NV: %d\n", ds[vt].maNV);
        printf("Ho ten: %s\n", ds[vt].hoTen);
        printf("Ngay sinh: %s\n", ds[vt].ngaySinh);
        printf("Luong: %.2f trieu\n", ds[vt].luong);
    } else {
        printf("\nKhong tim thay nhan vien co luong %.2f", X);
    }

    return 0;
}
