#include <stdio.h>
#include <string.h>

struct HangHoa {
    int maHH;
    char tenHH[50];
    char ngayXuat[11];
    float giaXuat;
};

void nhap(struct HangHoa ds[], int n) {
    int i;
    for(i = 0; i < n; i++) {
        printf("\nNhap hang hoa thu %d:\n", i + 1);

        printf("Ma hang hoa: ");
        scanf("%d", &ds[i].maHH);
        getchar();

        printf("Ten hang hoa: ");
        gets(ds[i].tenHH);

        printf("Ngay xuat (dd/mm/yyyy): ");
        gets(ds[i].ngayXuat);

        printf("Gia xuat (trieu dong): ");
        scanf("%f", &ds[i].giaXuat);
        getchar();
    }
}

void xuat(struct HangHoa ds[], int n) {
    int i;
    printf("\nDANH SACH HANG HOA\n");

    for(i = 0; i < n; i++) {
        printf("\nMa HH: %d", ds[i].maHH);
        printf("\nTen HH: %s", ds[i].tenHH);
        printf("\nNgay xuat: %s", ds[i].ngayXuat);
        printf("\nGia xuat: %.2f trieu\n", ds[i].giaXuat);
    }
}

void selectionSort(struct HangHoa ds[], int n) {
    int i, j, min;
    struct HangHoa temp;

    for(i = 0; i < n - 1; i++) {
        min = i;

        for(j = i + 1; j < n; j++) {
            if(ds[j].giaXuat < ds[min].giaXuat)
                min = j;
        }

        if(min != i) {
            temp = ds[i];
            ds[i] = ds[min];
            ds[min] = temp;
        }
    }
}

int binarySearch(struct HangHoa ds[], int n, float x) {
    int left = 0;
    int right = n - 1;

    while(left <= right) {
        int mid = (left + right) / 2;

        if(ds[mid].giaXuat == x)
            return mid;
        else if(ds[mid].giaXuat < x)
            left = mid + 1;
        else
            right = mid - 1;
    }

    return -1;
}

int main() {
    int n;
    float X;

    struct HangHoa ds[100];

    printf("Nhap so hang hoa: ");
    scanf("%d", &n);

    nhap(ds, n);

    printf("\nDanh sach vua nhap:\n");
    xuat(ds, n);

    selectionSort(ds, n);

    printf("\nDanh sach sau khi sap xep tang dan theo gia xuat:\n");
    xuat(ds, n);

    printf("\nNhap gia xuat can tim: ");
    scanf("%f", &X);

    int vt = binarySearch(ds, n, X);

    if(vt != -1) {
        printf("\nTim thay hang hoa:\n");
        printf("Ma HH: %d\n", ds[vt].maHH);
        printf("Ten HH: %s\n", ds[vt].tenHH);
        printf("Ngay xuat: %s\n", ds[vt].ngayXuat);
        printf("Gia xuat: %.2f trieu\n", ds[vt].giaXuat);
    }
    else {
        printf("\nKhong tim thay hang hoa co gia xuat %.2f", X);
    }

    return 0;
}
